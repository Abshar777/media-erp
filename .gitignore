# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
frontend/.next/
frontend/out/
frontend/build/
# Incremental compile cache — rewritten by every `tsc` run, so tracking it
# made a phantom change appear in everyone's working tree after any build.
*.tsbuildinfo
frontend/.env*.local
frontend/.env

# ── Python / FastAPI ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
*.egg
backend/.env
backend/.env.*
!backend/.env.example

# ── Secrets & credentials ─────────────────────────────────────────────────────
scripts/credentials.json
*.pem
*.key
*.p12

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Testing ──────────────────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
coverage/
.nyc_output/

# ── Misc ─────────────────────────────────────────────────────────────────────
.claude/settings.local.json
